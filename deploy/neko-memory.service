[Unit]
Description=NEKO private memory service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neko
Group=neko
WorkingDirectory=/opt/neko-one
EnvironmentFile=/etc/neko-public.env
ExecStart=/opt/neko-one/.venv/bin/python -m app.memory_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neko-public /var/lib/neko

[Install]
WantedBy=multi-user.target
