# Copy to /etc/neko-public.env and chmod 600. Never commit real values.
NEKO_PUBLIC_HOST=127.0.0.1
NEKO_PUBLIC_PORT=48911
NEKO_PUBLIC_FORWARDED_ALLOW_IPS=127.0.0.1
NEKO_PUBLIC_DATA_DIR=/var/lib/neko-public
# PostgreSQL is required. Use a dedicated, non-superuser role and keep the
# database loopback/private; percent-encode reserved characters in the password.
NEKO_PUBLIC_DATABASE_URL=postgresql://neko_public:replace-with-database-password@127.0.0.1:5432/neko_public
NEKO_PUBLIC_ALLOWED_ORIGINS=https://neko.pardofelis.wiki
NEKO_PUBLIC_ALLOW_MISSING_ORIGIN=0
NEKO_PUBLIC_SECURE_COOKIE=1
NEKO_PUBLIC_SESSION_SECRET=replace-with-at-least-48-random-characters
NEKO_PUBLIC_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
# Copy an operator-owned Cubism 4 model into
# $NEKO_PUBLIC_DATA_DIR/live2d/<name>/ and set both values. The repository does
# not bundle a character model or grant model/voice publication rights.
NEKO_PUBLIC_LIVE2D_MODEL_NAME=
NEKO_PUBLIC_LIVE2D_MODEL_FILE=
# Optional Soullink continuous-expression runtime. Generate the profile with
# `npm --prefix frontend/soullink run profile -- <model-name>` after installing
# the operator-owned model, then enable it explicitly.
NEKO_PUBLIC_SOULLINK_ENABLED=0
NEKO_PUBLIC_SOULLINK_MOTION_STYLE=natural
NEKO_PUBLIC_MAX_HTTP_BODY_BYTES=32768
NEKO_PUBLIC_WS_MAX_SIZE_BYTES=16384
NEKO_PUBLIC_WS_MAX_FRAME_CHARS=8192
NEKO_PUBLIC_WS_MAX_QUEUE=32
NEKO_PUBLIC_HTTP_KEEP_ALIVE_SECONDS=5
NEKO_PUBLIC_MIN_FREE_MIB=256

# Server-only RoomDirector; one timer per room, never one per browser.
NEKO_PUBLIC_PROACTIVE_ENABLED=0
NEKO_PUBLIC_PROACTIVE_IDLE_SECONDS=120
NEKO_PUBLIC_PROACTIVE_COOLDOWN_SECONDS=300
NEKO_PUBLIC_LLM_TIMEOUT_SECONDS=120
NEKO_PUBLIC_TTS_TIMEOUT_SECONDS=90
NEKO_PUBLIC_TTS_ATTEMPTS=2
NEKO_PUBLIC_MEMORY_WRITE_ATTEMPTS=3

# Finite retention defaults. Persisted admin settings override these values.
NEKO_PUBLIC_MESSAGE_RETENTION_DAYS=30
NEKO_PUBLIC_VISITOR_RETENTION_DAYS=90
NEKO_PUBLIC_AUDIT_RETENTION_DAYS=180
NEKO_PUBLIC_SPEECH_RETENTION_HOURS=24
NEKO_PUBLIC_CLEANUP_INTERVAL_MINUTES=60

# LLM/TTS provider keys remain in the existing private config store. They must
# never be placed in frontend files or returned by public APIs.
