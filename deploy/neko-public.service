[Unit]
Description=NEKO public room web service
After=network-online.target neko-memory.service
Wants=network-online.target
Requires=neko-memory.service

[Service]
Type=simple
User=neko
Group=neko
WorkingDirectory=/opt/neko-one
EnvironmentFile=/etc/neko-public.env
ExecStart=/opt/neko-one/.venv/bin/python -m app.public_room_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neko-public /var/lib/neko

[Install]
WantedBy=multi-user.target
