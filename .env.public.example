# Copy to /etc/neko-public.env and chmod 600. Never commit real values.
NEKO_PUBLIC_HOST=127.0.0.1
NEKO_PUBLIC_PORT=48911
NEKO_PUBLIC_FORWARDED_ALLOW_IPS=127.0.0.1
NEKO_PUBLIC_DATA_DIR=/var/lib/neko-public
NEKO_PUBLIC_ALLOWED_ORIGINS=https://neko.example.com
NEKO_PUBLIC_SECURE_COOKIE=1
NEKO_PUBLIC_SESSION_SECRET=replace-with-at-least-48-random-characters
NEKO_PUBLIC_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

# Server-only RoomDirector; one timer per room, never one per browser.
NEKO_PUBLIC_PROACTIVE_ENABLED=0
NEKO_PUBLIC_PROACTIVE_IDLE_SECONDS=120
NEKO_PUBLIC_PROACTIVE_COOLDOWN_SECONDS=300
NEKO_PUBLIC_TTS_TIMEOUT_SECONDS=90

# Finite retention defaults. Persisted admin settings override these values.
NEKO_PUBLIC_MESSAGE_RETENTION_DAYS=30
NEKO_PUBLIC_VISITOR_RETENTION_DAYS=90
NEKO_PUBLIC_AUDIT_RETENTION_DAYS=180
NEKO_PUBLIC_SPEECH_RETENTION_HOURS=24
NEKO_PUBLIC_CLEANUP_INTERVAL_MINUTES=60

# LLM/TTS provider keys remain in the existing private config store. They must
# never be placed in frontend files or returned by public APIs.
